    @{
    ViewData["Title"] = "Đặt Hàng Thành Công";
}

<div class="container my-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-5">
                <div class="mb-3">
                    <i class="bi bi-check-circle-fill text-success display-1"></i>
                </div>
                <h2 class="fw-bold text-success mb-3">ĐẶT HÀNG THÀNH CÔNG!</h2>
                <p class="fs-5 text-muted">
                    Cảm ơn bạn đã mua sắm tại <strong>HTT SHOP GUNDAM</strong>.
                </p>
                <div class="alert alert-secondary my-3">
                    Mã đơn hàng của bạn là: <strong>#@ViewBag.OrderId</strong>
                </div>
                <p class="text-muted small mb-4">
                    Đơn hàng đã được lưu vào hệ thống. Chúng tôi sẽ liên hệ xác nhận trong thời gian sớm nhất.
                </p>
                <div>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg fw-bold px-4">
                        Tiếp Tục Mua Hàng
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
