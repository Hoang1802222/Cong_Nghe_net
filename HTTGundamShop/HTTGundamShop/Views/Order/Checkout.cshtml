@model HTTGundamShop.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Thanh Toán Đơn Hàng";
}

<div class="container my-5">
    <h2 class="fw-bold text-uppercase text-primary mb-4">
        <i class="bi bi-credit-card"></i> Thông Tin Thanh Toán
    </h2>

    <form asp-action="Checkout" method="post">
        <div class="row">
            <!-- Cột trái: Nhập thông tin khách hàng -->
            <div class="col-lg-7 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-primary text-white py-3">
                        <h5 class="mb-0 fw-bold">Thông Tin Giao Hàng</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-bold">Họ và tên người nhận (*)</label>
                            <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label fw-bold">Số điện thoại (*)</label>
                            <input asp-for="Phone" class="form-control" placeholder="0901234567" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-bold">Địa chỉ nhận hàng (*)</label>
                            <textarea asp-for="Address" class="form-control" rows="3" placeholder="Số nhà, tên đường, phường/xã, quận/huyện..."></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Note" class="form-label fw-bold">Ghi chú đơn hàng (Tùy chọn)</label>
                            <textarea asp-for="Note" class="form-control" rows="2" placeholder="Ghi chú thêm về thời gian giao hàng..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Tóm tắt đơn hàng -->
            <div class="col-lg-5">
                <div class="card shadow-sm border-0 bg-light">
                    <div class="card-header bg-secondary text-white py-3">
                        <h5 class="mb-0 fw-bold">Sản Phẩm Đặt Mua</h5>
                    </div>
                    <div class="card-body p-4">
                        <ul class="list-group list-group-flush mb-3">
                            @if (Model?.CartItems != null)
                            {
                                @foreach (var item in Model.CartItems)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0 py-2">
                                        <div>
                                            <h6 class="my-0 text-dark fw-bold">@item.ProductName</h6>
                                            <small class="text-muted">SL: @item.Quantity x @item.Price.ToString("N0") VNĐ</small>
                                        </div>
                                        <span class="fw-bold text-danger">@item.Total.ToString("N0") VNĐ</span>
                                    </li>
                                }
                            }
                        </ul>

                        <div class="d-flex justify-content-between pt-3 border-top fs-5">
                            <span class="fw-bold">Tổng thanh toán:</span>
                            <span class="fw-bold text-danger">@(Model?.GrandTotal.ToString("N0") ?? "0") VNĐ</span>
                        </div>

                        <hr class="my-4" />

                        <button type="submit" class="btn btn-success btn-lg w-100 fw-bold py-3">
                            XÁC NHẬN ĐẶT HÀNG
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>