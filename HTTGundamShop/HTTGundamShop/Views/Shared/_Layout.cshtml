<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HTT SHOP GUNDAM</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .navbar-brand {
            font-weight: 800;
            letter-spacing: 1px;
        }
        .nav-link {
            font-weight: 600;
        }
        .card-product {
            transition: transform 0.2s, shadow 0.2s;
        }
        .card-product:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.12) !important;
        }
        footer {
            background-color: #111;
            color: #ccc;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Top Bar Thông báo -->
    <div class="bg-primary text-white text-center py-1 small fw-bold">
        🚀 HTT SHOP GUNDAM - Chuyên Mô Hình Gundam Bandai Chính Hãng | Hotline: 0987.654.321
    </div>

    <!-- Header Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm py-3">
        <div class="container">
            <!-- Logo -->
            <a class="navbar-brand text-warning fs-4 me-4" href="/">
                <i class="bi bi-robot me-2"></i>HTT GUNDAM
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <!-- Menu điều hướng -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/"><i class="bi bi-house-door me-1"></i>Trang Chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Product"><i class="bi bi-grid me-1"></i>Sản Phẩm</a>
                    </li>
                </ul>

                <!-- Form Tìm kiếm -->
                <form class="d-flex me-3" action="/Product" method="get" style="max-width: 300px; width: 100%;">
                    <div class="input-group">
                        <input class="form-control form-control-sm border-0" type="search" name="search" placeholder="Tìm tên Gundam..." value="@Context.Request.Query["search"]" />
                        <button class="btn btn-warning btn-sm fw-bold" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <!-- Giỏ hàng & Tài khoản -->
                <div class="d-flex align-items-center gap-2 mt-2 mt-lg-0">
                    <!-- Nút Giỏ Hàng -->
                    <a href="/Cart" class="btn btn-outline-warning btn-sm fw-bold position-relative px-3 py-2">
                        <i class="bi bi-cart3 me-1"></i>Giỏ Hàng
                        <!-- Số lượng trong giỏ -->
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            @(Context.Session.GetInt32("CartCount") ?? 0)
                        </span>
                    </a>

                    <!-- Khu vực Đăng nhập / Tài khoản -->
                    @if (Context.Session.GetString("UserName") != null)
                    {
                        <div class="dropdown">
                            <button class="btn btn-light btn-sm fw-bold dropdown-toggle px-3 py-2" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1 text-primary"></i>@Context.Session.GetString("UserName")
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                @if (Context.Session.GetString("Role") == "Admin")
                                {
                                    <li><a class="dropdown-menu-item text-danger fw-bold dropdown-item" href="/Admin/AdminHome"><i class="bi bi-speedometer2 me-2"></i>Trang Quản Trị Admin</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                }
                                <li><a class="dropdown-item fw-bold" href="/Account/MyOrders"><i class="bi bi-bag-check me-2"></i>Đơn Hàng Của Tôi</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger fw-bold" href="/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng Xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/Account/Login" class="btn btn-primary btn-sm fw-bold px-3 py-2">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Đăng Nhập
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="mt-5 py-4">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="text-warning fw-bold"><i class="bi bi-robot me-2"></i>HTT SHOP GUNDAM</h5>
                    <p class="small text-secondary">Hệ thống bán lẻ mô hình Gunpla, Gundam Bandai chính hàng Nhật Bản hàng đầu Việt Nam.</p>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white fw-bold mb-3">Liên Hệ</h6>
                    <p class="small mb-1"><i class="bi bi-geo-alt me-2 text-primary"></i>Hà Nội, Việt Nam</p>
                    <p class="small mb-1"><i class="bi bi-telephone me-2 text-primary"></i>0987.654.321</p>
                    <p class="small mb-0"><i class="bi bi-envelope me-2 text-primary"></i>contact@httgundam.vn</p>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white fw-bold mb-3">Chính Sách</h6>
                    <ul class="list-unstyled small text-secondary">
                        <li><a href="#" class="text-decoration-none text-secondary">Giao hàng & Thanh toán</a></li>
                        <li><a href="#" class="text-decoration-none text-secondary">Chính sách bảo hành & Đổi trả</a></li>
                        <li><a href="#" class="text-decoration-none text-secondary">Hướng dẫn lắp ráp Gunpla</a></li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary my-3" />
            <div class="text-center small text-secondary">
                © 2026 HTT Shop Gundam. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>