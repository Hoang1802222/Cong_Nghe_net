@model HTTGundamShop.Models.Category

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm Danh Mục Mới";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white fw-bold py-3">
                    <i class="bi bi-folder-plus me-2"></i>Thêm Danh Mục Mới
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên Danh Mục <span class="text-danger">*</span></label>
                            <input asp-for="CategoryName" class="form-control" placeholder="Nhập tên danh mục (VD: High Grade (HG), Master Grade (MG)...)" required />
                            <span asp-validation-for="CategoryName" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a href="/Admin/AdminCategory" class="btn btn-outline-secondary fw-bold">
                                <i class="bi bi-arrow-left me-1"></i>Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-primary fw-bold px-4">
                                <i class="bi bi-floppy me-1"></i>Lưu Danh Mục
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>