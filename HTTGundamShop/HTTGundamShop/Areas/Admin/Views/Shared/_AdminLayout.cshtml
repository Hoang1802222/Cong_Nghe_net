<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HTT Shop Admin</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow-x: hidden;
        }

        /* Sidebar Styling (AdminLTE Style) */
        .admin-sidebar {
            width: 250px;
            min-height: 100vh;
            background-color: #343a40;
            color: #c2c7d0;
            transition: all 0.3s;
        }

        .admin-brand {
            background-color: #212529;
            padding: 15px 20px;
            font-size: 1.2rem;
            font-weight: bold;
            color: #fff;
            border-bottom: 1px solid #4b545c;
            display: block;
            text-decoration: none;
        }

        .admin-sidebar .nav-link {
            color: #c2c7d0;
            padding: 12px 20px;
            border-radius: 4px;
            margin: 2px 10px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .admin-sidebar .nav-link:hover,
        .admin-sidebar .nav-link.active {
            background-color: #007bff;
            color: #fff;
        }

        .admin-sidebar .nav-header {
            font-size: 0.75rem;
            text-transform: uppercase;
            padding: 10px 20px 5px;
            color: #6c757d;
            font-weight: bold;
        }

        /* Main Content */
        .admin-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .admin-navbar {
            background-color: #fff;
            border-bottom: 1px solid #dee2e6;
            padding: 10px 25px;
        }

        .admin-content {
            padding: 25px;
            flex: 1;
        }

        .admin-footer {
            background-color: #fff;
            border-top: 1px solid #dee2e6;
            padding: 15px 25px;
            font-size: 0.9rem;
            color: #6c757d;
        }
    </style>
</head>
<body>

    <div class="d-flex">
        <!-- SIDEBAR -->
        <aside class="admin-sidebar d-flex flex-column">
            <a href="#" class="admin-brand text-center">
                <i class="bi bi-robot text-primary me-2"></i>HTT GUNDAM
            </a>

            <!-- Admin Profile Quick Info -->
            <div class="p-3 d-flex align-items-center border-bottom border-secondary">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; font-weight: bold;">
                    A
                </div>
                <div>
                    <div class="fw-bold text-white">@User.Identity?.Name</div>
                    <small class="text-success"><i class="bi bi-circle-fill" style="font-size: 8px;"></i> Online (Admin)</small>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="nav flex-column mt-2">
                <div class="nav-header">MAIN NAVIGATION</div>

                <div class="list-group list-group-flush my-3">
                    <!-- 1. Tổng quan -->
                    <a href="/Admin/AdminHome" class="list-group-item list-group-item-action bg-transparent text-white fw-bold py-2">
                        <i class="bi bi-speedometer2 me-2"></i>Tổng Quan
                    </a>

                    <!-- 2. Quản lý Sản phẩm -->
                    <a href="/Admin/AdminProduct" class="list-group-item list-group-item-action bg-transparent text-white fw-bold py-2">
                        <i class="bi bi-box-seam me-2"></i>Quản Lý Sản Phẩm
                    </a>

                    <!-- 3. Quản lý Danh mục -->
                    <a href="/Admin/AdminCategory" class="list-group-item list-group-item-action bg-transparent text-white fw-bold py-2">
                        <i class="bi bi-tags me-2"></i>Quản Lý Danh Mục
                    </a>

                    <!-- 4. Quản lý Đơn hàng -->
                    <a href="/Admin/AdminOrder" class="list-group-item list-group-item-action bg-transparent text-white fw-bold py-2">
                        <i class="bi bi-cart-check me-2"></i>Quản Lý Đơn Hàng
                    </a>

                    <!-- 5. Quản lý Tài khoản -->
                    <a href="/Admin/AdminUser" class="list-group-item list-group-item-action bg-transparent text-white fw-bold py-2">
                        <i class="bi bi-people me-2"></i>Quản Lý Tài Khoản
                    </a>

                    <!-- 6. Về trang chủ Shop -->
                    <a href="/" class="list-group-item list-group-item-action bg-transparent text-warning fw-bold py-2 mt-4 border-top border-secondary">
                        <i class="bi bi-house-door me-2"></i>Xem Trang Chủ Shop
                    </a>
                </div>

                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="px-2 mt-2">
                    <button type="submit" class="btn btn-outline-danger w-100 text-start d-flex align-items-center gap-2">
                        <i class="bi bi-box-arrow-right fs-5"></i>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            </nav>
        </aside>

        <!-- MAIN CONTAINER -->
        <div class="admin-main">
            <!-- Header Navbar -->
            <header class="admin-navbar d-flex justify-content-between align-items-center shadow-sm">
                <div class="d-flex align-items-center gap-3">
                    <h5 class="m-0 fw-bold text-secondary">BẢNG QUẢN TRỊ HỆ THỐNG</h5>
                </div>
                <div>
                    <span class="me-3 text-muted">Xin chào, <strong class="text-dark">@User.Identity?.Name</strong></span>
                </div>
            </header>

            <!-- Main Content Area -->
            <main class="admin-content">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="admin-footer d-flex justify-content-between align-items-center">
                <span>&copy; 2026 - <strong>HTT SHOP GUNDAM ADMIN</strong></span>
                <span>Phiên bản 1.0.0</span>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>