@model IEnumerable<HTTGundamShop.Models.Order>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Trang Tổng Quan Admin";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="mb-4">
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-speedometer2 me-2 text-primary"></i>Trang Tổng Quan (Dashboard)
        </h3>
        <p class="text-muted small mb-0">Thống kê hoạt động kinh doanh của HTT Shop Gundam</p>
    </div>

    <!-- 4 Card Thống Kê -->
    <div class="row g-3 mb-4">
        <!-- Doanh thu -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 bg-primary text-white h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small text-uppercase fw-bold mb-1">Tổng Doanh Thu</div>
                        <h4 class="fw-bold mb-0">@ViewBag.TotalRevenue.ToString("N0") VNĐ</h4>
                    </div>
                    <div class="fs-1 text-white-50">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Đơn hàng -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 bg-success text-white h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small text-uppercase fw-bold mb-1">Đơn Hàng</div>
                        <h4 class="fw-bold mb-0">@ViewBag.TotalOrders đơn</h4>
                    </div>
                    <div class="fs-1 text-white-50">
                        <i class="bi bi-cart-check"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sản phẩm -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 bg-warning text-dark h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-dark-50 small text-uppercase fw-bold mb-1">Sản Phẩm Gundam</div>
                        <h4 class="fw-bold mb-0">@ViewBag.TotalProducts mẫu</h4>
                    </div>
                    <div class="fs-1 text-dark-50">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Người dùng -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-3 bg-info text-white h-100">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small text-uppercase fw-bold mb-1">Tài Khoản</div>
                        <h4 class="fw-bold mb-0">@ViewBag.TotalUsers khách</h4>
                    </div>
                    <div class="fs-1 text-white-50">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng đơn hàng mới nhất -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-clock-history me-2 text-primary"></i>Đơn Hàng Gần Đây
            </h5>
            <a href="/Admin/AdminOrder" class="btn btn-sm btn-outline-primary fw-bold">Xem tất cả</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="text-secondary small text-uppercase">
                            <th class="ps-4 py-3">Mã đơn</th>
                            <th class="py-3">Khách hàng</th>
                            <th class="py-3">Ngày đặt</th>
                            <th class="py-3">Tổng tiền</th>
                            <th class="py-3">Trạng thái</th>
                            <th class="py-3 text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-bold text-primary">#@item.OrderId</td>
                                    <td class="py-3 fw-bold text-dark">@(item.User?.UserName ?? "Khách vãng lai")</td>
                                    <td class="py-3 text-muted">
                                        @(item.OrderDate.HasValue ? item.OrderDate.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")
                                    </td>
                                    <td class="py-3 text-danger fw-bold">@item.TotalAmount.ToString("N0") VNĐ</td>
                                    <td class="py-3">
                                        <span class="badge bg-secondary-subtle text-dark fw-bold px-2 py-1">@item.OrderStatus</span>
                                    </td>
                                    <td class="text-center pe-4 py-3">
                                        <a href="/Admin/AdminOrder/Details/@item.OrderId" class="btn btn-sm btn-outline-primary fw-bold">
                                            Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Chưa có đơn hàng nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>