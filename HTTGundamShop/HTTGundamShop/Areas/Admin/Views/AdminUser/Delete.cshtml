@model HTTGundamShop.Models.User

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Xóa Tài Khoản";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white fw-bold py-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác Nhận Xóa Tài Khoản
                </div>
                <div class="card-body p-4">
                    <p class="text-dark fw-bold mb-3">
                        Bạn có chắc chắn muốn xóa tài khoản này khỏi hệ thống?
                    </p>
                    <div class="bg-light p-3 rounded mb-4 border">
                        <p class="mb-1"><strong>Tài khoản:</strong> @Model.UserName</p>
                        <p class="mb-0"><strong>Email:</strong> @(Model.Email ?? "N/A")</p>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="UserId" />
                        <div class="d-flex justify-content-between">
                            <a href="/Admin/AdminUser" class="btn btn-secondary fw-bold px-4">Hủy</a>
                            <button type="submit" class="btn btn-danger fw-bold px-4">Xác Nhận Xóa</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>