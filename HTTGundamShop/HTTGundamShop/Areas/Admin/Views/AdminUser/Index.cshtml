@model IEnumerable<HTTGundamShop.Models.User>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản Lý Tài Khoản";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-people me-2 text-primary"></i>Quản Lý Tài Khoản
            </h3>
            <p class="text-muted small mb-0">Danh sách các thành viên và tài khoản quản trị trong hệ thống</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show fw-bold mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Bảng danh sách người dùng -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr class="text-secondary small text-uppercase">
                            <th class="ps-4 py-3">Mã TK</th>
                            <th class="py-3">Tài khoản / Email</th>
                            <th class="py-3 text-center">Số đơn đã đặt</th>
                            <th class="py-3 text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-bold text-primary">#@item.UserId</td>
                                    <td class="py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold me-3" style="width: 40px; height: 40px;">
                                                @(string.IsNullOrEmpty(item.UserName) ? "U" : item.UserName.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@item.UserName</div>
                                                <small class="text-muted">@(item.Email ?? "Chưa có Email")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center py-3">
                                        <span class="badge bg-secondary-subtle text-secondary fw-bold px-3 py-2 fs-6">
                                            @(item.Orders?.Count ?? 0) đơn
                                        </span>
                                    </td>
                                    <td class="text-center pe-4 py-3">
                                        <a href="/Admin/AdminUser/Details/@item.UserId" class="btn btn-sm btn-outline-primary fw-bold me-1">
                                            <i class="bi bi-eye me-1"></i>Chi tiết
                                        </a>
                                        <a href="/Admin/AdminUser/Delete/@item.UserId" class="btn btn-sm btn-outline-danger fw-bold">
                                            <i class="bi bi-trash me-1"></i>Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                                    <span>Chưa có tài khoản nào trong hệ thống.</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>