@model IEnumerable<HTTGundamShop.Models.Order>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; // 👈 Đường dẫn Layout Admin
    ViewData["Title"] = "Quản Lý Đơn Hàng";
    string currentStatus = ViewBag.CurrentStatus as string;
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-cart-check me-2 text-primary"></i>Quản Lý Đơn Hàng
            </h3>
            <p class="text-muted small mb-0">Theo dõi và cập nhật trạng thái đơn hàng Gundam</p>
        </div>
    </div>

    <!-- Bộ lọc trạng thái -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-2">
            <ul class="nav nav-pills gap-2">
                <li class="nav-item">
                    <a class="nav-link fw-bold @(string.IsNullOrEmpty(currentStatus) ? "active" : "text-dark")" href="/Admin/AdminOrder">Tất cả</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-bold @(currentStatus == "Chờ xử lý" ? "active bg-warning text-dark" : "text-dark")" href="/Admin/AdminOrder?status=Chờ xử lý">Chờ xử lý</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-bold @(currentStatus == "Đang giao" ? "active bg-info text-white" : "text-dark")" href="/Admin/AdminOrder?status=Đang giao">Đang giao</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-bold @(currentStatus == "Đã hoàn thành" ? "active bg-success text-white" : "text-dark")" href="/Admin/AdminOrder?status=Đã hoàn thành">Đã hoàn thành</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-bold @(currentStatus == "Đã hủy" ? "active bg-danger text-white" : "text-dark")" href="/Admin/AdminOrder?status=Đã hủy">Đã hủy</a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Bảng danh sách đơn hàng -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr class="text-secondary small text-uppercase">
                            <th class="ps-4 py-3">Mã đơn</th>
                            <th class="py-3">Khách hàng</th>
                            <th class="py-3">Ngày đặt</th>
                            <th class="py-3">Địa chỉ giao</th>
                            <th class="py-3">Tổng tiền</th>
                            <th class="py-3">Trạng thái</th>
                            <th class="py-3 text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-bold text-primary">#@item.OrderId</td>
                                    <td class="py-3">
                                        <div class="fw-bold text-dark">@(item.User?.UserName ?? "Khách vãng lai")</div>
                                        <small class="text-muted">@(item.User?.Email ?? "")</small>
                                    </td>
                                    <td class="py-3 text-muted">
                                        @(item.OrderDate.HasValue ? item.OrderDate.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")
                                    </td>
                                    <td class="py-3 text-truncate" style="max-width: 200px;" title="@item.ShippingAddress">
                                        @item.ShippingAddress
                                    </td>
                                    <td class="py-3">
                                        <span class="text-danger fw-bold fs-6">@item.TotalAmount.ToString("N0") VNĐ</span>
                                    </td>
                                    <td class="py-3">
                                        @if (item.OrderStatus == "Đã hoàn thành")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success fw-bold px-2 py-1">Đã hoàn thành</span>
                                        }
                                        else if (item.OrderStatus == "Đã hủy")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger fw-bold px-2 py-1">Đã hủy</span>
                                        }
                                        else if (item.OrderStatus == "Đang giao")
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info fw-bold px-2 py-1">Đang giao</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning fw-bold px-2 py-1">Chờ xử lý</span>
                                        }
                                    </td>
                                    <td class="text-center pe-4 py-3">
                                        <!-- NÚT CHI TIẾT TRỎ TRỰC TIẾP URL -->
                                        <a href="/Admin/AdminOrder/Details/@item.OrderId" class="btn btn-sm btn-outline-primary fw-bold px-3">
                                            <i class="bi bi-eye me-1"></i>Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">Chưa có đơn hàng nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>