@model IEnumerable<HTTGundamShop.Models.Product>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản Lý Sản Phẩm Gundam";
}

<div class="container-fluid px-4 mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold">Quản Lý Sản Phẩm</h2>
            <p class="text-muted mb-0">Danh sách các mô hình Gundam trong hệ thống</p>
        </div>
        
        <!-- NÚT THÊM MỚI -->
        <a href="/Admin/AdminProduct/Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Thêm Sản Phẩm Mới
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">Mã SP</th>
                            <th>Tên sản phẩm</th>
                            <th>Giá bán</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">#@item.ProductId</td>
                                    <td>
                                        <div class="fw-semibold">@item.ProductName</div>
                                    </td>
                                    <td class="text-danger fw-bold">
                                        @item.Price.ToString("N0") VNĐ
                                    </td>
                                    <td>
                                        <!-- NÚT SỬA -->
                                        <a href="/Admin/AdminProduct/Edit/@item.ProductId" class="btn btn-sm btn-warning text-white me-1">
                                            <i class="fas fa-edit me-1"></i> Sửa
                                        </a>

                                        <!-- NÚT XÓA -->
                                        <a href="/Admin/AdminProduct/Delete/@item.ProductId" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash me-1"></i> Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    Chưa có sản phẩm nào trong hệ thống.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>