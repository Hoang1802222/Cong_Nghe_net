@model HTTGundamShop.Models.Product

@{

    ViewData["Title"] = "Thêm Gundam Mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-plus-lg"></i> Thêm Sản Phẩm Gundam Mới</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" enctype="multipart/form-data" method="post">
                        <div class="mb-3">
                            <label asp-for="ProductName" class="form-label fw-bold">Tên sản phẩm (*)</label>
                            <input asp-for="ProductName" class="form-control" placeholder="Ví dụ: RG 1/144 RX-78-2 Gundam" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Price" class="form-label fw-bold">Giá bán (VNĐ) (*)</label>
                            <input asp-for="Price" type="number" class="form-control" placeholder="550000" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Chọn hình ảnh sản phẩm</label>
                            <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Mô tả sản phẩm</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập thông tin chi tiết về sản phẩm..."></textarea>
                        </div>

                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
                            <button type="submit" class="btn btn-success fw-bold px-4">Lưu Sản Phẩm</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>