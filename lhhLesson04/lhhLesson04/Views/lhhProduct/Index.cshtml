@using lhhLesson04.Models

@{
    ViewData["Title"] = "Gundam Store";

var products = ViewBag.Products as List<Product>;
    var categories = ViewBag.Categories as List<Category>;


}

<div class="container mt-4">

    
    <!-- DANH MỤC -->
    <h2 class="text-center mb-4">Danh mục Gundam</h2>

    <div class="row mb-5">
        @foreach (var category in categories)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm">
                    <div class="card-body text-center">

                        <h5 class="card-title">
                            @category.CategoryName
                        </h5>

                        <p class="text-muted">
                            Mã danh mục: @category.CategoryID
                        </p>

                        <button class="btn btn-dark">
                            Xem sản phẩm
                        </button>

                    </div>
                </div>
            </div>
        }
    </div>


    <!-- SẢN PHẨM -->
    <h2 class="text-center mb-4">Danh sách sản phẩm</h2>

    <div class="row">

        @foreach (var product in products)
        {
            <div class="col-md-4 mb-4">

                <div class="card h-100 shadow-sm">

                    <img src="@product.ProductImages"
                         class="card-img-top"
                         alt="@product.ProductName"
                         style="height:250px; object-fit:contain;">

                    <div class="card-body">

                        <h5 class="card-title">
                            @product.ProductName
                        </h5>

                        <p class="card-text">
                            @product.ProductDescription
                        </p>

                        <p>
                            <del>
                                @product.ProductPrice
                            </del>

                            <strong class="text-danger ms-2">
                                @product.ProductSalePrice
                            </strong>
                        </p>

                        <p>
                            Trạng thái:
                            <span class="text-success">
                                @product.ProductStatus
                            </span>
                        </p>

                        <p>
                            Ngày tạo:
                            @product.ProductCreatedDate.ToString("dd/MM/yyyy")
                        </p>

                        <button class="btn btn-primary w-100">
                            Xem sản phẩm
                        </button>

                    </div>

                </div>

            </div>
        }

    </div>
    

</div>
