@{
    ViewData["Title"] = "Thong tin sinh vien ne";
}
<div class="alert alert-info" role="alert">
    <h2 class="alert-heading">@ViewData["Title"]</h2>
    <p>Họ và tên: @Model.Name</p>
    <p>Mã sinh viên: @Model.MSV</p>
    <p>Lớp: @Model.Class</p>
    <p>Email: @Model.Email</p>
    <p>Điện thoại: @Model.Phone</p>
</div>