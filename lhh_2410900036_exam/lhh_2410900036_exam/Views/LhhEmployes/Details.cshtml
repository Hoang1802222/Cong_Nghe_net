@model lhh_2410900036_exam.Models.LhhEmploye

@{
    ViewData["Title"] = "Chi tiết nhân viên";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <!-- Header Card -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h3 mb-0 text-gray-800 fw-bold">
                        <i class="bi bi-person-vcard text-primary me-2"></i>Chi tiết nhân viên
                    </h2>
                    <p class="text-muted small mb-0">Xem toàn bộ thông tin hồ sơ của nhân viên</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại
                </a>
            </div>

            <!-- Profile Info Card -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="bi bi-info-circle text-primary me-2"></i>Thông tin cá nhân
                    </h5>
                    <!-- Badge Mã ID -->
                    <span class="badge bg-light text-dark border">
                        ID: #@Model?.Id
                    </span>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0 gy-3">
                        <!-- Họ và tên -->
                        <dt class="col-sm-4 text-secondary">
                            <i class="bi bi-person me-1"></i>@Html.DisplayNameFor(model => model.LhhName):
                        </dt>
                        <dd class="col-sm-8 fw-semibold text-dark fs-6 mb-0">
                            @Html.DisplayFor(model => model.LhhName)
                        </dd>

                        <!-- Giới tính -->
                        <dt class="col-sm-4 text-secondary">
                            <i class="bi bi-gender-ambiguous me-1"></i>@Html.DisplayNameFor(model => model.LhhGender):
                        </dt>
                        <div class="mb-3">
    <label asp-for="LhhGender" class="form-label fw-semibold">Giới tính</label>
    <select asp-for="LhhGender" class="form-select">
        <option value="">-- Chọn giới tính --</option>
        <option value="Nam">Nam</option>
        <option value="Nữ">Nữ</option>
        <option value="Khác">Khác</option>
    </select>
    <span asp-validation-for="LhhGender" class="text-danger small"></span>
</div>

                        <!-- Ngày sinh -->
                        <dt class="col-sm-4 text-secondary">
                            <i class="bi bi-calendar-event me-1"></i>@Html.DisplayNameFor(model => model.LhhBirthDay):
                        </dt>
                        <dd class="col-sm-8 text-dark mb-0">
                            @Html.DisplayFor(model => model.LhhBirthDay)
                        </dd>

                        <!-- Email -->
                        <dt class="col-sm-4 text-secondary">
                            <i class="bi bi-envelope me-1"></i>@Html.DisplayNameFor(model => model.LhhEmail):
                        </dt>
                        <dd class="col-sm-8 text-dark mb-0">
                            @if (!string.IsNullOrEmpty(Model.LhhEmail))
                            {
                                <a href="mailto:@Model.LhhEmail" class="text-decoration-none">
                                    @Html.DisplayFor(model => model.LhhEmail)
                                </a>
                            }
                            else
                            {
                                <span class="text-muted fs-7">Chưa cập nhật</span>
                            }
                        </dd>

                        <!-- Số điện thoại -->
                        <dt class="col-sm-4 text-secondary">
                            <i class="bi bi-telephone me-1"></i>@Html.DisplayNameFor(model => model.LhhPhone):
                        </dt>
                        <dd class="col-sm-8 text-dark mb-0">
                            @if (!string.IsNullOrEmpty(Model.LhhPhone))
                            {
                                <a href="tel:@Model.LhhPhone" class="text-decoration-none">
                                    @Html.DisplayFor(model => model.LhhPhone)
                                </a>
                            }
                            else
                            {
                                <span class="text-muted fs-7">Chưa cập nhật</span>
                            }
                        </dd>

                        <!-- Trạng thái Active -->
                        <dt class="col-sm-4 text-secondary">
                            <i class="bi bi-check-circle me-1"></i>@Html.DisplayNameFor(model => model.LhhActive):
                        </dt>
                        <dd class="col-sm-8 mb-0">
                            @if (Model.LhhActive == true)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                    <i class="bi bi-dot"></i>Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">
                                    <i class="bi bi-dot"></i>Khóa
                                </span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <!-- Actions Bar -->
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light border px-4 rounded-pill">
                    <i class="bi bi-arrow-left me-1"></i>Danh sách
                </a>
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning px-4 rounded-pill shadow-sm fw-semibold">
                    <i class="bi bi-pencil-square me-1"></i>Chỉnh sửa
                </a>
            </div>
        </div>
    </div>
</div>