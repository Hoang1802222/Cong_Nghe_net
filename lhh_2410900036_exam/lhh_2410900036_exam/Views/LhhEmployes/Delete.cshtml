@model lhh_2410900036_exam.Models.LhhEmploye

@{
    ViewData["Title"] = "Xác nhận xóa nhân viên";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <!-- Header Card -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h3 mb-0 text-danger fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa
                    </h2>
                    <p class="text-muted small mb-0">Thao tác này sẽ xóa vĩnh viễn dữ liệu khỏi hệ thống</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại
                </a>
            </div>

            <!-- Warning Alert -->
            <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center mb-4 rounded-3" role="alert">
                <i class="bi bi-shield-exclamation fs-3 me-3 text-warning"></i>
                <div>
                    <strong>Bạn có chắc chắn muốn xóa nhân viên này?</strong>
                    <div class="small text-secondary">Hành động này không thể hoàn tác sau khi xác nhận.</div>
                </div>
            </div>

            <!-- Details Card -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="bi bi-person-badge text-primary me-2"></i>Thông tin nhân viên
                    </h5>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0 gy-3">
                        <!-- Họ và tên -->
                        <dt class="col-sm-4 text-secondary">
                            <i class="bi bi-person me-1"></i>Họ và tên:
                        </dt>
                        <dd class="col-sm-8 fw-semibold text-dark mb-0">
                            @Html.DisplayFor(model => model.LhhName)
                        </dd>

                        <!-- Giới tính -->
                        <dt class="col-sm-3 text-secondary">
    <i class="bi bi-gender-ambiguous me-1"></i>Giới tính:
</dt>
<dd class="col-sm-9">
    @if (Model.LhhGender == "Nam")
    {
        <span class="badge bg-primary">Nam</span>
    }
    else if (Model.LhhGender == "Nữ")
    {
        <span class="badge bg-danger">Nữ</span>
    }
    else
    {
        <span class="badge bg-secondary">@(Model.LhhGender ?? "Chưa nhập")</span>
    }
</dd>

                        <!-- Ngày sinh -->
                        <dt class="col-sm-4 text-secondary">
                            <i class="bi bi-calendar-event me-1"></i>Ngày sinh:
                        </dt>
                        <dd class="col-sm-8 text-dark mb-0">
                            @Html.DisplayFor(model => model.LhhBirthDay)
                        </dd>

                        <!-- Email -->
                        <dt class="col-sm-4 text-secondary">
                            <i class="bi bi-envelope me-1"></i>Email:
                        </dt>
                        <dd class="col-sm-8 text-dark mb-0">
                            @Html.DisplayFor(model => model.LhhEmail)
                        </dd>

                        <!-- Số điện thoại -->
                        <dt class="col-sm-4 text-secondary">
                            <i class="bi bi-telephone me-1"></i>Số điện thoại:
                        </dt>
                        <dd class="col-sm-8 text-dark mb-0">
                            @Html.DisplayFor(model => model.LhhPhone)
                        </dd>

                        <!-- Trạng thái Active -->
                        <dt class="col-sm-4 text-secondary">
                            <i class="bi bi-check-circle me-1"></i>Trạng thái:
                        </dt>
                        <dd class="col-sm-8 mb-0">
                            @if (Model.LhhActive == true)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                    <i class="bi bi-dot"></i>Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">
                                    <i class="bi bi-dot"></i>Khóa
                                </span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <!-- Action Form -->
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border px-4 rounded-pill">Hủy bỏ</a>
                    <button type="submit" class="btn btn-danger px-4 rounded-pill shadow-sm fw-semibold">
                        <i class="bi bi-trash me-1"></i>Xác nhận xóa
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>