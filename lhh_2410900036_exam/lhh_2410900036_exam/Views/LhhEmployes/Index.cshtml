@model IEnumerable<lhh_2410900036_exam.Models.LhhEmploye>

@{
    ViewData["Title"] = "Danh sách nhân viên";
}

<div class="container-fluid py-4">
    <!-- Header Card -->
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm border-start border-primary border-4">
        <div>
            <h2 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-people-fill text-primary me-2"></i>Danh sách nhân viên
            </h2>
            <p class="text-muted small mb-0">Quản lý thông tin và trạng thái nhân viên hệ thống</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-md shadow-sm rounded-pill px-3 fw-semibold">
            <i class="bi bi-plus-lg me-1"></i>Thêm mới nhân viên
        </a>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr class="text-secondary text-uppercase small fs-7">
                            <th class="ps-4 py-3">
                                <i class="bi bi-person me-1"></i>@Html.DisplayNameFor(model => model.LhhName)
                            </th>
                            <th class="py-3">
                                <i class="bi bi-gender-ambiguous me-1"></i>@Html.DisplayNameFor(model => model.LhhGender)
                            </th>
                            <th class="py-3">
                                <i class="bi bi-calendar-event me-1"></i>@Html.DisplayNameFor(model => model.LhhBirthDay)
                            </th>
                            <th class="py-3">
                                <i class="bi bi-envelope me-1"></i>@Html.DisplayNameFor(model => model.LhhEmail)
                            </th>
                            <th class="py-3">
                                <i class="bi bi-telephone me-1"></i>@Html.DisplayNameFor(model => model.LhhPhone)
                            </th>
                            <th class="py-3 text-center">
                                <i class="bi bi-check-circle me-1"></i>@Html.DisplayNameFor(model => model.LhhActive)
                            </th>
                            <th class="text-end pe-4 py-3">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    Chưa có dữ liệu nhân viên.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <!-- Họ tên -->
                                    <td class="ps-4 fw-semibold text-dark">
                                        @Html.DisplayFor(model => item.LhhName)
                                    </td>

                                    <td>
    @if (item.LhhGender == "Nam")
    {
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1">
            <i class="bi bi-gender-male me-1"></i>Nam
        </span>
    }
    else if (item.LhhGender == "Nữ")
    {
        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1">
            <i class="bi bi-gender-female me-1"></i>Nữ
        </span>
    }
    else
    {
        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">
            @(item.LhhGender ?? "Khác")
        </span>
    }
</td>

                                    <!-- Ngày sinh -->
                                    <td class="text-secondary">
                                        @Html.DisplayFor(model => item.LhhBirthDay)
                                    </td>

                                    <!-- Email -->
                                    <td class="text-secondary">
                                        <a href="mailto:@item.LhhEmail" class="text-decoration-none text-reset">
                                            @Html.DisplayFor(model => item.LhhEmail)
                                        </a>
                                    </td>

                                    <!-- Số điện thoại -->
                                    <td class="text-secondary">
                                        @Html.DisplayFor(model => item.LhhPhone)
                                    </td>

                                    <!-- Trạng thái Active -->
                                    <td class="text-center">
                                        @if (item.LhhActive == true)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                                <i class="bi bi-dot"></i>Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">
                                                <i class="bi bi-dot"></i>Khóa
                                            </span>
                                        }
                                    </td>

                                    <!-- Nhóm nút bấm Action -->
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>