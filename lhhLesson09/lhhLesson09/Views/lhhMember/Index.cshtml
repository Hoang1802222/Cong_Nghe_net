@model IEnumerable<lhhLesson09.Models.DataviewModel.lhhMemberRegister>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<div class="container mt-4">
    <h2 class="mb-3">Danh sách thành viên</h2>

    <p>
        <a asp-action="Create" class="btn btn-primary">Thêm mới thành viên</a>
    </p>

    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.lhhMemberId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.lhhMemberName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.lhhMemberEmail)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.lhhMemberPhone)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.lhhFullname)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.lhhBirtday)
                </th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.lhhMemberId)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.lhhMemberName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.lhhMemberEmail)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.lhhMemberPhone)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.lhhFullname)
                        </td>
                        <td>
                            @item.lhhBirtday.ToString("dd/MM/yyyy")
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.lhhMemberId" class="btn btn-sm btn-warning">Sửa</a>
                            <a asp-action="Details" asp-route-id="@item.lhhMemberId" class="btn btn-sm btn-info">Chi tiết</a>
                            <a asp-action="Delete" asp-route-id="@item.lhhMemberId" class="btn btn-sm btn-danger">Xóa</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">Chưa có dữ liệu thành viên nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>