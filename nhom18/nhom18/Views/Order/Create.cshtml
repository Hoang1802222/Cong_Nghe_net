@model nhom18.Models.Order

@{
    ViewData["Title"] = "Gọi món - " + ViewBag.Ban.TenBan;
    var ban = ViewBag.Ban as nhom18.Models.Ban;
    var danhSachMon = ViewBag.DanhSachMon as List<nhom18.Models.Mon>;
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gọi món cho: <span class="text-primary">@ban.TenBan</span> (Khu vực: @ban.KhuVuc)</h2>
        <a asp-controller="Ban" asp-action="Index" class="btn btn-secondary">&larr; Quay lại sơ đồ bàn</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="row">
        <!-- Cột trái: Thực đơn -->
        <div class="col-md-7">
            <h4 class="mb-3">Thực đơn quán</h4>
            <div class="row">
                @if (danhSachMon != null)
                {
                    foreach (var mon in danhSachMon)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card h-100 shadow-sm">
                                @if (!string.IsNullOrEmpty(mon.AnhMon))
                                {
                                    <img src="@mon.AnhMon" class="card-img-top" style="height: 120px; object-fit: cover;" alt="@mon.TenMon" />
                                }
                                else
                                {
                                    <div class="bg-secondary text-white text-center d-flex align-items-center justify-content-center" style="height: 120px;">Không có ảnh</div>
                                }
                                <div class="card-body p-2 d-flex flex-column">
                                    <h6 class="card-title fw-bold text-truncate">@mon.TenMon</h6>
                                    <p class="text-danger fw-bold mb-2">@mon.GiaBan.ToString("N0") đ</p>
                                    
                                    <form asp-action="ThemMon" method="post" class="mt-auto">
                                        <input type="hidden" name="maBan" value="@ban.MaBan" />
                                        <input type="hidden" name="maMon" value="@mon.MaMon" />
                                        <div class="mb-1">
                                            <input type="text" name="ghiChu" class="form-control form-control-sm" placeholder="Ghi chú (ít đá, ít ngọt...)" />
                                        </div>
                                        <div class="input-group input-group-sm">
                                            <input type="number" name="soLuong" value="1" min="1" class="form-control text-center" style="max-width: 60px;" />
                                            <button type="submit" class="btn btn-primary w-100">Thêm</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Cột phải: Hóa đơn / Giỏ hàng tạm -->
        <div class="col-md-5">
            <div class="card shadow-sm sticky-top" style="top: 20px;">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Hóa đơn hiện tại</h5>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.ChiTietOrders != null && Model.ChiTietOrders.Any())
                    {
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Món</th>
                                    <th>SL</th>
                                    <th>Đơn giá</th>
                                    <th>Tiền</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var chiTiet in Model.ChiTietOrders)
                                {
                                    <tr>
                                          <td>
                                            @chiTiet.MaMonNavigation.TenMon
                                            @if (!string.IsNullOrEmpty(chiTiet.GhiChu))
                                            {
                                                <br /><small class="text-muted">(@chiTiet.GhiChu)</small>
                                            }
                                        </td>
                                        <td>@chiTiet.SoLuong</td>
                                        <td>@chiTiet.DonGia.ToString("N0")</td>
                                        <td class="fw-bold">@((chiTiet.SoLuong * chiTiet.DonGia).ToString("N0"))</td>
                                        <td>
                                            <form asp-action="XoaMonChiTiet" method="post">
                                                <input type="hidden" name="maOrder" value="@chiTiet.MaOrder" />
                                                <input type="hidden" name="maMon" value="@chiTiet.MaMon" />
                                                <input type="hidden" name="maBan" value="@ban.MaBan" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm">&times;</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        
                        <hr />
                        <div class="d-flex justify-content-between mb-3">
                            <h4 class="fw-bold">Tổng tiền:</h4>
                            <h4 class="text-danger fw-bold">@Model.TongTien.ToString("N0") đ</h4>
                        </div>

                        <form asp-action="ThanhToan" method="post" onsubmit="return confirm('Xác nhận thanh toán và đóng bàn này?');">
                            <input type="hidden" name="maOrder" value="@Model.MaOrder" />
                            <button type="submit" class="btn btn-success w-100 py-2 fw-bold">Thanh Toán & Đóng Bàn</button>
                        </form>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">Bàn chưa gọi món nào.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>