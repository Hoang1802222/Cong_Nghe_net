@model nhom18.Models.DanhMucMon

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>Cập nhật danh mục món ăn</h2>
    <hr />
    <form asp-action="Edit">
        <input type="hidden" asp-for="MaDm" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        
        <div class="mb-3">
            <label asp-for="TenDm" class="form-label">Tên danh mục</label>
            <input asp-for="TenDm" class="form-control" />
            <span asp-validation-for="TenDm" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ThuTu" class="form-label">Thứ tự hiển thị</label>
            <input asp-for="ThuTu" class="form-control" type="number" />
            <span asp-validation-for="ThuTu" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </form>
</div>