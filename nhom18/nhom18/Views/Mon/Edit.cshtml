@model nhom18.Models.Mon

@{
    ViewData["Title"] = "Chỉnh sửa món";
}

<div class="container px-4">
    <h2 class="mt-4">Chỉnh sửa thông tin món</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="MaMon" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="TenMon" class="form-label fw-bold">Tên món</label>
                    <input asp-for="TenMon" class="form-control" />
                    <span asp-validation-for="TenMon" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MaDm" class="form-label fw-bold">Danh mục</label>
                    <select asp-for="MaDm" class="form-select" asp-items="ViewBag.MaDm"></select>
                    <span asp-validation-for="MaDm" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="GiaBan" class="form-label fw-bold">Giá bán (VNĐ)</label>
                    <input asp-for="GiaBan" type="number" step="1000" class="form-control" />
                    <span asp-validation-for="GiaBan" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Ảnh hiện tại</label>
                    <div>
                        @if (!string.IsNullOrEmpty(Model.AnhMon))
                        {
                            <img src="@Model.AnhMon" alt="Ảnh món" style="width: 80px; height: 80px; object-fit: cover;" class="rounded mb-2" />
                        }
                        else
                        {
                            <p class="text-muted">Chưa có ảnh</p>
                        }
                    </div>
                    <label class="form-label fw-bold">Đổi ảnh mới (nếu muốn)</label>
                    <input type="file" name="anhMonFile" class="form-control" accept="image/*" />
                </div>

                <div class="mb-3">
                    <label asp-for="MoTa" class="form-label fw-bold">Mô tả</label>
                    <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="MoTa" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TrangThai" class="form-label fw-bold">Trạng thái</label>
                    <select asp-for="TrangThai" class="form-select">
                        <option value="Đang bán">Đang bán</option>
                        <option value="Ngừng bán">Ngừng bán</option>
                    </select>
                    <span asp-validation-for="TrangThai" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Cập nhật</button>
                    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}