@model IEnumerable<nhom18.Models.Mon>

@{
    ViewData["Title"] = "Quản lý Thực đơn Món";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Quản lý Món ăn / Thức uống</h1>

    <!-- Hiển thị thông báo (nếu có) từ Controller -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- THANH TÌM KIẾM VÀ LỌC -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body" >
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">Tìm theo tên món</label>
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Nhập tên món..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Danh mục</label>
                    <select name="maDm" class="form-select" asp-items="ViewBag.DanhSachDm">
                        <option value="">-- Tất cả danh mục --</option>
                    </select>
                </div>
                
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100 me-1"><i class="fas fa-search"></i> Lọc</button>
                </div>
            </form>
        </div>
    </div>

    <!-- NÚT THÊM MỚI -->
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus"></i> Thêm món mới</a>
    </div>

    <!-- BẢNG HIỂN THỊ DANH SÁCH MÓN -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Ảnh</th>
                            <th>Tên món</th>
                            <th>Danh mục</th>
                            <th>Giá bán</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.AnhMon))
                                        {
                                            <img src="@item.AnhMon" alt="@item.TenMon" style="width: 60px; height: 60px; object-fit: cover;" class="rounded" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">Không có ảnh</span>
                                        }
                                    </td>
                                    <td class="fw-bold">@item.TenMon</td>
                                    <td>@(item.MaDmNavigation != null ? item.MaDmNavigation.TenDm : "---")</td>
                                    <td class="text-danger fw-bold">@item.GiaBan.ToString("N0") VNĐ</td>
                                    <td class="text-center">
                                        @if (item.TrangThai == "Ngừng bán")
                                        {
                                            <span class="badge bg-danger">Ngừng bán</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Đang bán</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Edit" asp-route-id="@item.MaMon" class="btn btn-warning btn-sm text-white" title="Sửa"><i class="fas fa-edit"></i> Sửa</a>

                                        <!-- Form Xóa / Chuyển ngừng bán -->
                                        <form asp-action="XoaHoacNgungBan" asp-route-id="@item.MaMon" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn thực hiện thao tác này với món @item.TenMon không?');">
                                            <button type="submit" class="btn btn-danger btn-sm" title="Xóa / Ngừng bán"><i class="fas fa-trash"></i> Xóa</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Không tìm thấy món ăn nào phù hợp.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- PHÂN TRANG -->
            @if (ViewBag.TotalPages > 1)
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center mt-3">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-searchString="@ViewBag.CurrentSearch"
                                   asp-route-maDm="@Context.Request.Query["maDm"]">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>