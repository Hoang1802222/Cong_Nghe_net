<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AdminLTE Cafe</title>

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Theme style AdminLTE -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <!-- Custom site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">

        <!-- Navbar (Topbar trên cùng) -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <!-- Left navbar links -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a asp-controller="Ban" asp-action="Index" class="nav-link fw-bold">Trang chủ</a>
                </li>
            </ul>

            <!-- Right navbar links -->
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
            </ul>
        </nav>
        <!-- /.navbar -->

        <!-- Main Sidebar Container (Thanh Menu bên trái chuẩn AdminLTE) -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Brand Logo -->
            <a asp-controller="Ban" asp-action="Index" class="brand-link text-center">
                <span class="brand-text font-weight-bold text-warning">☕ NHÓM 18 CAFE</span>
            </a>

            <!-- Sidebar -->
            <div class="sidebar">
                <!-- Sidebar Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        
                        <!-- Sơ đồ Bàn -->
                        <li class="nav-item">
                            <a asp-controller="Ban" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-th"></i>
                                <p>Sơ đồ Bàn</p>
                            </a>
                        </li>

                        <!-- Quản lý Món -->
                        <li class="nav-item">
                            <a asp-controller="Mon" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-coffee"></i>
                                <p>Quản lý Món ăn</p>
                            </a>
                        </li>

                        <!-- Danh mục Món -->
                        <li class="nav-item">
                            <a asp-controller="DanhMucMon" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-list"></i>
                                <p>Danh mục Món</p>
                            </a>
                        </li>

                        <!-- Lịch sử Hóa đơn -->
                        <li class="nav-item">
                            <a asp-controller="Order" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-file-invoice-dollar"></i>
                                <p>Lịch sử Hóa đơn</p>
                            </a>
                        </li>

                        <li class="nav-header">BÁO CÁO & THỐNG KÊ</li>

                        <!-- Thống kê Doanh thu -->
                        <li class="nav-item">
                            <a asp-controller="ThongKe" asp-action="Index" class="nav-link text-warning">
                                <i class="nav-icon fas fa-chart-line"></i>
                                <p>Thống kê Doanh thu</p>
                            </a>
                        </li>

                    </ul>
                </nav>
                <!-- /.sidebar-menu -->
            </div>
            <!-- /.sidebar -->
        </aside>

        <!-- Content Wrapper. Contains page content -->
        <div class="content-wrapper">
            <!-- Main content -->
            <section class="content pt-3">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
            <!-- /.content -->
        </div>
        <!-- /.content-wrapper -->

        <footer class="main-footer">
            <div class="float-right d-none d-sm-inline">
                Hệ thống Quản lý Cà phê
            </div>
            <strong>Copyright &copy; @DateTime.Now.Year Nhóm 18.</strong> All rights reserved.
        </footer>
    </div>
    <!-- ./wrapper -->

    <!-- REQUIRED SCRIPTS -->
    <!-- jQuery -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <!-- Bootstrap 4 -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE App -->
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>