@model IEnumerable<lhhLap06.Models.lhhCategory>

@{
    ViewData["Title"] = "Danh sach danh muc";
}

<h1>Danh sach danh muc</h1>

<p>
    <a  class="btn btn-sm btn-success"
       asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.categoryName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.categoryName)
            </td>
            <td>
                @Html.DisplayFor(model => item.status)
            </td>
            <td>
                @Html.DisplayFor(model => item.CreatedDate)
            </td>
            
            <td>
                <a asp-action="Edit" asp-route-id="@item.categoryId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.categoryId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.categoryId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
