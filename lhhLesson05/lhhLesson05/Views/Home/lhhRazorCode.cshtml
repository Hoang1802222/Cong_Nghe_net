@{
    ViewData["Title"] = "Cu phap co ban cua Razor ne"; 
}
<h1>@ViewData["Title"]</h1>
<hr/>
@{
    var total = 8000;
    var myMessage = "Ban Giaun Vi Ci Eo";
}
<p>tai khoan cua ban: @total</p>
<p>tin nhan: @myMessage</p>
<hr/>
<h2>CAU TRUC IF</h2>
@if (total > 5000)
{
<div class="alert alert-success" role="alert">
    <strong>Chuc mung ban da duoc tang tien</strong>
</div>
}
else
{
<div class="alert alert-danger" role="alert">
    <strong>Ban chua duoc tang tien</strong>
</div>
}
<hr/>
<h2>CAU TRUC FOR</h2>
@for (int i = 1; i <= 10; i++)
{
    if (i % 2 == 0)
    {
        <span class="btn btn-danger">@i la so chan</span>
    }
    else
    {
        <span class="btn btn-primary">@i la so le</span>
    }
}
<hr/>
<h2>MANG NE</h2>
@{
    string[] lhhArray = { "icon1.jpg", "icon1.webp", "icon2.png", "icon3.webp", "icon4.png" };
}
@foreach (var item in lhhArray)
{
<img src="~/images/@item" width="150" height="150" />
}