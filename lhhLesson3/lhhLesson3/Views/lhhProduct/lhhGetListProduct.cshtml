@model List<lhhLesson3.Models.lhhProduct>

<h1>Danh sách Gundam-Model</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>STT</th>
            <th>Product ID</th>
            <th>Product Name</th>
            <th>Price</th>
            <th>Year Release</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @{
            int stt = 0;
        }

        @foreach (var item in Model)
        {
            stt++;

            <tr>
                <td>@stt</td>
                <td>@item.lhhProductID</td>
                <td>@item.lhhProductName</td>
                <td>@item.lhhPrice.ToString("N0")</td>
                <td>@item.lhhYearRelease</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = item.lhhProductID })"
                       class="btn btn-primary">
                        Edit
                    </a>

                    <a href="@Url.Action("Delete", new { id = item.lhhProductID })"
                       class="btn btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>

    <tfoot>
        <tr>
            <td colspan="6" class="text-center">
                Tổng số sản phẩm: @Model.Count
            </td>
        </tr>
    </tfoot>
</table>

