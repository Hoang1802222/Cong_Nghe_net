
@model IEnumerable<lhhLesson08.Models.lhhMember>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<div class="container mt-4">

    <!-- Tiêu đề -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary">
                <i class="bi bi-people-fill"></i> Danh sách thành viên
            </h2>
            <p class="text-muted mb-0">
                Quản lý thông tin các thành viên
            </p>
        </div>

        <a asp-action="lhhCreate" class="btn btn-primary">
            <i class="bi bi-person-plus-fill"></i>
            Thêm thành viên
        </a>
    </div>

    <!-- Card chứa bảng -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                Danh sách thành viên
            </h5>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Họ và tên</th>
                            <th>Email</th>
                            <th>Mật khẩu</th>
                            <th>Số điện thoại</th>
                            <th class="text-center" style="width: 220px;">
                                Thao tác
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @Html.DisplayFor(modelItem => item.lhhMemberName)
                                </td>

                                <td>
                                    <i class="bi bi-envelope"></i>
                                    @Html.DisplayFor(modelItem => item.lhhMemberEmail)
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @Html.DisplayFor(modelItem => item.lhhMemberPassword)
                                    </span>
                                </td>

                                <td>
                                    <i class="bi bi-telephone"></i>
                                    @Html.DisplayFor(modelItem => item.lhhMemberPhone)
                                </td>

                                <td class="text-center">

                                    <a asp-action="lhhEdit"
                                       asp-route-id="@item.lhhMemberID"
                                       class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil-square"></i>
                                        Sửa
                                    </a>

                                    <a asp-action="lhhDetails"
                                       asp-route-id="@item.lhhMemberID"
                                       class="btn btn-info btn-sm text-white">
                                        <i class="bi bi-eye-fill"></i>
                                        Xem
                                    </a>

                                    <a asp-action="lhhDelete"
                                       asp-route-id="@item.lhhMemberID"
                                       class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash-fill"></i>
                                        Xóa
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            </div>

        </div>

    </div>

</div>
