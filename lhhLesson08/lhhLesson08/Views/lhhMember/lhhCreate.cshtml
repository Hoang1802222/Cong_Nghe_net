
@model lhhLesson08.Models.lhhMember

@{
    ViewData["Title"] = "Tạo thành viên";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="card shadow border-0">

                <!-- Header -->
                <div class="card-header bg-primary text-white text-center py-3">
                    <h3 class="mb-0">
                        <i class="bi bi-person-plus-fill"></i>
                        Tạo thành viên
                    </h3>
                </div>

                <!-- Form -->
                <div class="card-body p-4">

                    <form asp-action="lhhCreate" method="post">

                        <!-- Validation -->
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <!-- Họ tên -->
                        <div class="mb-3">
                            <label asp-for="lhhMemberName"
                                   class="form-label fw-semibold">
                                Họ và tên
                            </label>

                            <input asp-for="lhhMemberName"
                                   class="form-control"
                                   placeholder="Nhập họ và tên" />

                            <span asp-validation-for="lhhMemberName"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="lhhMemberEmail"
                                   class="form-label fw-semibold">
                                Email
                            </label>

                            <input asp-for="lhhMemberEmail"
                                   class="form-control"
                                   type="email"
                                   placeholder="example@gmail.com" />

                            <span asp-validation-for="lhhMemberEmail"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Mật khẩu -->
                        <div class="mb-3">
                            <label asp-for="lhhMemberPassword"
                                   class="form-label fw-semibold">
                                Mật khẩu
                            </label>

                            <input asp-for="lhhMemberPassword"
                                   class="form-control"
                                   type="password"
                                   placeholder="Nhập mật khẩu" />

                            <span asp-validation-for="lhhMemberPassword"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Số điện thoại -->
                        <div class="mb-4">
                            <label asp-for="lhhMemberPhone"
                                   class="form-label fw-semibold">
                                Số điện thoại
                            </label>

                            <input asp-for="lhhMemberPhone"
                                   class="form-control"
                                   placeholder="Nhập số điện thoại" />

                            <span asp-validation-for="lhhMemberPhone"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary flex-fill">
                                <i class="bi bi-save"></i>
                                Lưu thông tin
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary flex-fill">
                                <i class="bi bi-arrow-left"></i>
                                Trở về danh sách
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>